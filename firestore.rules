rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função para validar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função para validar se o usuário é o dono do documento
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Função para validar estrutura de dados de vocabulário (para coleção direta)
    function isValidVocabularyData() {
      return request.resource.data.keys().hasAll(['foreignWord', 'portuguese', 'language', 'createdAt', 'mastered', 'userId']) &&
             request.resource.data.foreignWord is string &&
             request.resource.data.portuguese is string &&
             request.resource.data.language in ['english', 'french'] &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.mastered is bool &&
             request.resource.data.userId is string &&
             request.resource.data.foreignWord.size() > 0 &&
             request.resource.data.foreignWord.size() <= 50 &&
             request.resource.data.portuguese.size() > 0 &&
             request.resource.data.portuguese.size() <= 100 &&
             request.resource.data.userId == request.auth.uid;
    }

    // Função para validar atualização (permite campos parciais)
    function isValidUpdateData() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foreignWord', 'portuguese', 'language', 'mastered', 'pronunciation']) &&
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['foreignWord']) ||
              (request.resource.data.foreignWord is string &&
               request.resource.data.foreignWord.size() > 0 &&
               request.resource.data.foreignWord.size() <= 50)) &&
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['portuguese']) ||
              (request.resource.data.portuguese is string &&
               request.resource.data.portuguese.size() > 0 &&
               request.resource.data.portuguese.size() <= 100)) &&
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['language']) ||
              request.resource.data.language in ['english', 'french']) &&
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['mastered']) ||
              request.resource.data.mastered is bool);
    }

    // Regras para coleção direta de palavras (estrutura atual)
    match /words/{wordId} {
      // Leitura: apenas palavras do próprio usuário
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Criação: usuário autenticado + validação completa de dados
      allow create: if isAuthenticated() &&
                       isValidVocabularyData();

      // Atualização: apenas campos específicos, mantendo userId e createdAt
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       isValidUpdateData() &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt;

      // Exclusão: apenas o dono
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Regras para configurações do usuário
    match /userSettings/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Bloqueia acesso a qualquer outra coleção
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
